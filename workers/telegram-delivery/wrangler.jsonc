{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sathian-ai-telegram-delivery",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "STUDIO_BASE_URL": "https://sathian.ai"
  },
  "secrets": {
    "required": [
      "SUPABASE_URL",
      "SUPABASE_SERVICE_ROLE_KEY",
      "TELEGRAM_BOT_TOKEN",
      "TELEGRAM_CHAT_ID",
      "TELEGRAM_TOPIC_ID"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
